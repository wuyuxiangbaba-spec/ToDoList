+    // ---------- 撤销 / 重做（历史栈） ----------
+    // 快照口径：「一次用户操作完成后」的最终 state，JSON 深拷贝（字符串形式入栈）。
+    // 关于 getter：state 上的 nodes/links/linkDone 是不可枚举访问器（见上方 defineProperties，
+    // JSON.stringify 只序列化可枚举自有属性，因此这三个键不会出现在快照 JSON 里）；
+    // 但它们的底层数据本来就存放在 state.catalogs[i].nodes/links/linkDone 中，
+    // 随整份 JSON 一起被深拷贝，所以快照内容是完整的。
+    // 恢复（restoreSnapshot）不替换 state 对象、也不重定义访问器：只把快照里的
+    // 各数据字段回写进同一个 state（Object.assign），访问器动态读取 state.catalogs，
+    // 自动指向恢复后的当前目录——等效于「刷新了 getter」，无需任何额外处理。
+    // sidebarOpen 是纯视图状态（侧栏折叠/展开不算变更）：快照剔除、恢复时保留现值。
+    const HISTORY_MAX = 31; // 栈深上限 = 基线快照 + 30 步操作（超出丢最旧）
+    let historyStack = [];   // 每步快照的 JSON 字符串；historyStack[historyIndex] 即当前状态
+    let historyIndex = -1;
+    const undoBtn = document.getElementById("undoBtn");
+    const redoBtn = document.getElementById("redoBtn");
+
+    function snapshotState() {
+      // replacer 返回 undefined 的键不会写入 JSON：借此把 sidebarOpen 排除出历史
+      return JSON.stringify(state, (k, v) => (k === "sidebarOpen" ? undefined : v));
+    }
+    function restoreSnapshot(json) {
+      const keepSidebarOpen = state.sidebarOpen;
+      // 快照不含 nodes/links/linkDone 键，Object.assign 不会碰这三个访问器；
+      // catalogs / currentCatalogId / catalogInserts / neurCrossHidden / treeVersion 整体回写
+      Object.assign(state, JSON.parse(json));
+      state.sidebarOpen = keepSidebarOpen;
+      if (!currentCatalog()) state.currentCatalogId = state.catalogs[0].id; // 防御：快照异常时回落
+    }
+    function updateHistoryUi() {
+      if (undoBtn) undoBtn.disabled = historyIndex <= 0;
+      if (redoBtn) redoBtn.disabled = historyIndex >= historyStack.length - 1;
+    }
+    function pushHistory() {
+      const snap = snapshotState();
+      // 状态没变就不入栈（如把节点拖回原父节点、同值提交）：保证「一次操作 = 一步历史」
+      if (historyIndex >= 0 && historyStack[historyIndex] === snap) return;
+      historyStack = historyStack.slice(0, historyIndex + 1); // 新操作会截断撤销后的重做分支
+      historyStack.push(snap);
+      if (historyStack.length > HISTORY_MAX) historyStack.shift(); // 超出上限丢最旧
+      historyIndex = historyStack.length - 1;
+      updateHistoryUi();
+    }
+    // 撤销/重做前先收掉可能悬着的编辑器与浮层，避免它们引用已被恢复掉的对象
+    function closeHistoryAdjacentUi() {
+      if (editor) closeEditor(false);
+      if (catalogRenameClose) catalogRenameClose(false);
+      closeMenu();
+      closeLinkMenu();
+      closeCatMenu();
+      if (linkMode) exitLinkMode();
+    }
+    function undoHistory() {
+      if (historyIndex <= 0) return false;
+      const beforeCatalogId = state.currentCatalogId;
+      closeHistoryAdjacentUi();
+      historyIndex--;
+      restoreSnapshot(historyStack[historyIndex]);
+      if (state.currentCatalogId !== beforeCatalogId) pendingAutoFit = true; // 跨目录恢复时重新 fit 视野
+      save(false); // 恢复结果落盘，但不再入栈
+      render();
+      updateHistoryUi();
+      return true;
+    }
+    function redoHistory() {
+      if (historyIndex >= historyStack.length - 1) return false;
+      const beforeCatalogId = state.currentCatalogId;
+      closeHistoryAdjacentUi();
+      historyIndex++;
+      restoreSnapshot(historyStack[historyIndex]);
+      if (state.currentCatalogId !== beforeCatalogId) pendingAutoFit = true;
+      save(false);
+      render();
+      updateHistoryUi();
+      return true;
+    }
+    if (undoBtn) undoBtn.addEventListener("click", undoHistory);
+    if (redoBtn) redoBtn.addEventListener("click", redoHistory);
+
